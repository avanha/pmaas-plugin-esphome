<div class="entity-esphome-bluetooth{{if not .DeviceConnected}} offline{{end}}">
    <div class="title-row">
        <div class="name" title="{{.Name | html}}"><i class="bi bi-bluetooth"></i> {{.ShortName | html}}</div>
        {{if not .DeviceConnected}}
            <i class="bi bi-wifi-off offline-icon" title="The device is offline"></i>
        {{else}}
            <span class="scanning {{.Scanning | html}}">{{.Scanning | html}} scan</span>
        {{end}}
    </div>
    <div class="activity">
        <span class="stat"><span class="label">Batches</span> {{.Batches}}{{if not .LastBatchTime.IsZero}}, last {{RelativeTime .LastBatchTime}}{{end}}</span>
        <span class="stat"><span class="label">Heard</span> {{.Heard}}</span>
        <span class="stat"><span class="label">Forwarded</span> {{.Forwarded}}</span>
        {{if .Sighted}}<span class="stat"><span class="label">Sighted</span> {{.Sighted}}</span>{{end}}
        {{if .Dropped}}<span class="stat"><span class="label">Dropped</span> {{.Dropped}}</span>{{end}}
    </div>
    {{if .Quiet}}
        <div class="quiet-note"><i class="bi bi-exclamation-triangle-fill"></i> Nothing heard for a while: the proxy may have stopped hearing</div>
    {{end}}
    {{if not .DeviceConnected}}
        <div class="offline-note">Device offline {{if not .OfflineSince.IsZero}}since {{RelativeTime .OfflineSince}}{{end}}</div>
    {{end}}
</div>
