<div class="entity-esphome-switch {{.StateClass | html}}{{if not .DeviceConnected}} offline{{end}}" data-device="{{.DeviceName | html}}" data-object="{{.ObjectID | html}}">
    <div class="title-row">
        <div class="name" title="{{.Name | html}}">{{.ShortName | html}}</div>
        {{if not .DeviceConnected}}
            <i class="bi bi-wifi-off offline-icon" title="The device is offline, so this is its last known state"></i>
        {{end}}
    </div>
    {{if not .HasData}}
        <div class="waiting">Waiting for data</div>
    {{else}}
        <div class="state-row">
            {{/* The icon is the control: pressing it asks for the other state, and it's only a picture when the
                 switch can't be controlled. The state doesn't change until the device reports it. */}}
            <button type="button" class="switch-toggle {{.StateClass | html}}"
                    data-on="{{if eq .StateClass "on"}}false{{else}}true{{end}}"
                    title="{{if eq .StateClass "on"}}Turn off{{else}}Turn on{{end}}"
                    aria-label="{{if eq .StateClass "on"}}Turn off{{else}}Turn on{{end}} {{.Name | html}}"{{if not .CanControl}} disabled{{end}}>
                <i class="bi {{if eq .StateClass "on"}}bi-toggle-on{{else if eq .StateClass "off"}}bi-toggle-off{{else}}bi-question-circle-fill{{end}} switch-icon"></i>
            </button>
            <span class="state {{.StateClass | html}}">{{.State | html}}</span>
        </div>
        <div class="timestamp">
            {{if .LastChangeTime.IsZero}}
                <i class="bi bi-stopwatch"></i> Reported {{RelativeTime .LastUpdateTime}}
            {{else}}
                <i class="bi bi-stopwatch"></i> {{.State | html}} since {{RelativeTime .LastChangeTime}}
            {{end}}
        </div>
        <div class="switch-error"></div>
    {{end}}
    {{if not .DeviceConnected}}
        <div class="offline-note">
            Device offline {{if not .OfflineSince.IsZero}}since {{RelativeTime .OfflineSince}}{{end}}: last known state
        </div>
    {{end}}
</div>
