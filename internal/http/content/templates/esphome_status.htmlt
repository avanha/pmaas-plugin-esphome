<div class="entity-esphome-status">
    <div class="group">
        <div class="group-label">Broker</div>
        <div class="row">
            {{if .BrokerRunning}}
                <i class="bi bi-check-circle-fill ok"></i>
                <span class="label">Listening on</span> <span class="value">{{.ListenAddress | html}}</span>
            {{else if .BrokerNotUsed}}
                <i class="bi bi-dash-circle"></i>
                <span class="label">Not used</span>
                <span class="value">no MQTT devices are configured</span>
            {{else}}
                <i class="bi bi-x-circle-fill bad"></i>
                <span class="label">Not running</span>
                {{if .BrokerProblem}}<span class="problem wrap">{{.BrokerProblem | html}}</span>{{end}}
            {{end}}
        </div>
        <div class="row">
            <span class="label">Discovery prefix</span> <span class="value">{{.DiscoveryPrefix | html}}</span>
            {{if .CaptureMessages}}
                <span class="capture-note" title="CaptureMessages is on: every message a device sends is being logged">
                    <i class="bi bi-exclamation-triangle-fill"></i> Capturing messages
                </span>
            {{end}}
        </div>
        <div class="row">
            <span class="label">Last message</span>
            <span class="timestamp">
                {{if .LastMessageTime.IsZero}}Never{{else}}{{.LastMessageTime.Format "2006-01-02 3:04:05 PM"}} ({{RelativeTime .LastMessageTime}}){{end}}
            </span>
        </div>
        <div class="row">
            <span class="label">Devices</span>
            <span class="value">{{.ConnectedDevices}} of {{.DeviceCount}} connected</span>
        </div>
        <div class="row">
            <span class="label">Entities</span>
            <span class="value">
                {{.ThermometerCount}} thermometer{{if ne .ThermometerCount 1}}s{{end}},
                {{.DoorSensorCount}} door sensor{{if ne .DoorSensorCount 1}}s{{end}},
                {{.SwitchCount}} switch{{if ne .SwitchCount 1}}es{{end}},
                {{.PowerMonitorCount}} power monitor{{if ne .PowerMonitorCount 1}}s{{end}}
            </span>
        </div>
    </div>
</div>
